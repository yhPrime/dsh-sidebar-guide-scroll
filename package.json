{
  "name": "dsh-sidebar-guide-scroll",
  "version": "0.1.0",
  "description": "Make the right sidebar Start page scroll when its tool cards overflow.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/check.mjs && node test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "scroll"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhPrime/dsh-sidebar-guide-scroll.git"
  },
  "homepage": "https://github.com/yhPrime/dsh-sidebar-guide-scroll#readme",
  "bugs": {
    "url": "https://github.com/yhPrime/dsh-sidebar-guide-scroll/issues"
  },
  "author": "yhPrime",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
